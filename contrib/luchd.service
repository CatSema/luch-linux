[Unit]
Description=Luch sender daemon (screen mirroring to Luch receivers)
Documentation=https://github.com/Toxblh/luch-linux
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=dev.luch.Luch1
ExecStart=%h/.cargo/bin/luchd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
