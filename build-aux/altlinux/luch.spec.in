Name: luch
Version: @VERSION@
Release: alt@RELEASE@
Summary: Low-latency Linux screen mirroring to Luch receivers (Android TV, projectors)
License: GPL-3.0-or-later
Group: Video
Url: https://github.com/Toxblh/luch-linux
Source: %name-%version.tar

BuildRequires: rpm-build-rust rust rust-cargo gcc pkg-config clang
BuildRequires: libavcodec-devel libavutil-devel libva-devel libdrm-devel libglvnd-devel
BuildRequires: gstreamer1.0-devel gst-plugins1.0-devel

Requires: avahi-daemon
Requires: gst-plugins-base1.0 gst-plugins-good1.0 gst-plugins-bad1.0
Requires: pipewire

%description
Luch mirrors a Linux screen to an Android TV or a projector with game-streaming
latency. luchd is the user daemon (D-Bus dev.luch.Luch1), luchctl is the command
line front-end, luch-kms captures the KMS scanout for the lowest-latency mode.

%prep
%setup

%build
# The linker needs the libraries after the objects of the static KMS helper.
export RUSTFLAGS="-C link-arg=-lavcodec -C link-arg=-lavutil -C link-arg=-ldrm -C link-arg=-lEGL -C link-arg=-lGLESv2 -C link-arg=-lva"
cargo build --release --offline --locked

%install
install -Dm755 target/release/luchd %buildroot%_bindir/luchd
install -Dm755 target/release/luchctl %buildroot%_bindir/luchctl
install -Dm755 target/release/luch-kms %buildroot%_bindir/luch-kms
mkdir -p %buildroot%_userunitdir
sed 's|%%h/.cargo/bin/luchd|%_bindir/luchd|' contrib/luchd.service > %buildroot%_userunitdir/luchd.service
install -Dm644 /dev/stdin %buildroot%_prefix/lib/systemd/user-preset/90-luch.preset <<< 'enable luchd.service'

%post
# luch-kms reads the scanout framebuffer of other clients, which only a privileged process may do.
setcap cap_sys_admin+ep %_bindir/luch-kms || :

%files
%doc README.md
%_bindir/luchd
%_bindir/luchctl
%_bindir/luch-kms
%_userunitdir/luchd.service
%_prefix/lib/systemd/user-preset/90-luch.preset

%changelog
